 "shots": [
  {
   "at": 0,
   "text": "Ravan ne Hanuman ji ki poonch mein aag lagwa di."
  },
  {
   "at": 1.53,
   "text": "Rakshas hans rahe the."
  },
  {
   "at": 3.08,
   "text": "Par Hanuman ji muskuraye."
  },
  {
   "at": 4.73,
   "text": "Ek chhalaang..."
  },
  {
   "at": 6.13,
   "text": "aur ghar ghar mein aag!"
  },
  {
   "at": 7.73,
   "text": "Sone ki Lanka jal uthi."
  },
  {
   "at": 9.13,
   "text": "Ravan ka ghamand bhi jal gaya."
  },
  {
   "at": 10.78,
   "text": "Hanuman ji ne samudra mein poonch bujhayi."
  },
  {
   "at": 12.28,
   "text": "Aur Ram naam goonj utha."
  },
  {
   "at": 13.58,
   "text": "Jai Shri Ram!"
  }
